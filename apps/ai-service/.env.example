AI_SERVICE_NAME=CodeScry AI Service
AI_SERVICE_PORT=8000
NODE_API_URL=http://localhost:5000
ENVIRONMENT=development

AI_ANALYZER_MODE=llm
AI_PROVIDER=gemini

# Google Gemini API Key (Required - Get free key from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-pro
GEMINI_FLASH_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Qdrant Vector DB Settings (:memory:, local directory path ./qdrant_storage, or cloud URL)
QDRANT_URL=:memory:
QDRANT_API_KEY=
QDRANT_COLLECTION=codescry_best_practices

# GitHub Integration (Optional - for real PR reviews and commenting)
GITHUB_TOKEN=

# LangGraph Checkpoint Storage
CHECKPOINT_DB_PATH=review_checkpoints.db
